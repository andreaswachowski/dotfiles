[Unit]
Description=Decrypt ~/.secrets into tmpfs (/tmp/SecretsRAMDisk)
# Linux counterpart of Library/LaunchAgents/arpa.home.secrets_mount.plist##os.Darwin.
# Needs no interaction: sops uses the age key in ~/.config/sops/age/keys.txt and
# the script's "sudo mount -t tmpfs" relies on NOPASSWD sudo.

[Service]
Type=oneshot
RemainAfterExit=yes
# decrypt_secrets.sh runs "git ls-tree" relative to the current directory
WorkingDirectory=%h/.secrets
ExecStart=%h/.secrets/decrypt_secrets.sh

[Install]
WantedBy=default.target
