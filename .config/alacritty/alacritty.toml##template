[general]
import = ["~/.config/alacritty/gruvbox-modified.toml"]

[env]
TERM = "alacritty"

[terminal.shell]
{% if yadm.os == "Darwin" %}
program = "/opt/homebrew/bin/bash"
{% else %}
program = "/usr/bin/bash"
{% endif %}

# https://mnjm.github.io/posts/alacritty-and-tmux-preventing-duplicate-instances/
args = [ "-l", "-c", "tmux attach || tmux" ]

[font]
size = 12

[font.normal]
family = "Monaco Nerd Font Mono"
style = "Regular"

[window]
# Allows meta-shortcuts in neovim but prevents entering Umlauts the MacOS way
# (e.g., Option+u for ü). That's not a problem in neovim because the alternative
# "C-K : u" exists, but everywhere else.
# Use OnlyRight because we only need it for neomutt, and this preserves muscle
# memory for reaching umlauts with the left option key. 
option_as_alt = "OnlyRight"
position = { x = 40, y = 40 }

[window.dimensions]
columns = 230
lines = 60

[[keyboard.bindings]]
key = "Enter"
mods = "Command"
action = "ToggleFullscreen"

# https://vi.stackexchange.com/questions/41982/mapping-a-command-key-in-neovim-alacritty

