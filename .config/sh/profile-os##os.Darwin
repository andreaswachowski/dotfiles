# vi: filetype=sh
# shellcheck shell=sh

export ANDROID_HOME=~/Library/Android/sdk
export XDG_CONFIG_HOME=~/.config
export XDG_CACHE_HOME=~/.cache
export XDG_DATA_HOME=~/.local/share
export XDG_STATE_HOME=~/.local/state
path_append "${ANDROID_HOME}/tools"
path_append "${ANDROID_HOME}/platform-tools"
export MORE="-erFX $MORE" # Mac Os X uses less for more

# ---------------------------------------------------------------------------
#
# setup ssh-agent
#
# Use Apple's ssh-agent with Keychain integration for simplicity.
# Keys are added once with: /usr/bin/ssh-add --apple-use-keychain ~/.ssh/id_ed25519
# After that, they persist across reboots and work with both Apple and Homebrew SSH.

# Apple's ssh-agent is automatically managed by macOS. We just need to ensure
# keys are loaded when the agent starts fresh.
if [ -z "$SSH_TTY" ]; then # if not using ssh
  /usr/bin/ssh-add -l >/dev/null 2>&1
  if [ $? -eq 1 ]; then # agent reachable, no identities loaded
    # Use Apple's ssh-add with Keychain support for lazy-loading
    # This will pull keys from Keychain automatically
    alias ssh='/usr/bin/ssh-add -l >/dev/null 2>&1 || /usr/bin/ssh-add --apple-use-keychain; unalias ssh; ssh'
  fi
fi
