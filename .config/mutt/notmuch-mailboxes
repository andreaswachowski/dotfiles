# vi: filetype=muttrc

set folder             = ~/Mail
# https://neomutt.org/feature/notmuch#3-1-%C2%A0folders-url
# https://xapian.org/docs/queryparser.html
mailboxes -label "Inbox" "notmuch://?query=tag:inbox"
mailboxes -label "W9" "notmuch://?query=tag:w9 and not tag:trash"
mailboxes -label "Unread" "notmuch://?query=tag:unread and not tag:trash"
mailboxes -label "Unread in archives" "notmuch://?query=tag:unread and folder:/archives/"
mailboxes -label "Unread newsletter" "notmuch://?query=tag:unread and not tag:trash and tag:newsletter and not tag:tech and not tag:admin"
mailboxes -label "Unread sysadmin" "notmuch://?query=tag:unread and not tag:trash and tag:sysadmin"
mailboxes -label "Unread admin newsletter" "notmuch://?query=tag:unread and not tag:trash and tag:newsletter and tag:admin"
mailboxes -label "Unread tech newsletter" "notmuch://?query=tag:unread and not tag:trash and tag:newsletter and tag:tech"
mailboxes -label "Unread else inbox" "notmuch://?query=tag:unread and tag:inbox and not tag:newsletter and not tag:sysadmin and not tag:w9"
mailboxes -label "Unread else not inbox" "notmuch://?query=tag:unread and not tag:trash and not tag:inbox and not tag:newsletter and not tag:sysadmin and not tag:w9"
