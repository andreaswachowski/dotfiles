#!/usr/bin/env bash
# inbox: sync → neomutt → purge/archive
# Usage: inbox [-n|--offline]   skip pre/post sync

set -euo pipefail

OFFLINE=false
[[ "${1:-}" == "-n" || "${1:-}" == "--offline" ]] && OFFLINE=true

[ -e $HOME/.config/mutt/aliases ] || { cd "$HOME"/.secrets && ./decrypt_secrets.sh && cd -; }

if ! $OFFLINE; then
  echo "→ Checking mail..."
  check-mail.sh || echo "Warning: check-mail.sh failed — opening neomutt offline"
  echo "→ Processing DMARC reports..."
  notmuch-dmarc.py || echo "Warning: notmuch-dmarc.py failed"
fi

neomutt || true

if ! $OFFLINE; then
  echo "→ Purging trash..."
  notmuch-purge.sh
  echo "→ Archiving..."
  notmuch-archive.sh
  backup_stamp="$HOME/.cache/inbox/backup_email.last_run"
  backup_interval=$((2 * 60 * 60))
  now=$(date +%s)
  last_run=0
  [ -f "$backup_stamp" ] && last_run=$(cat "$backup_stamp")
  if [ $((now - last_run)) -ge "$backup_interval" ]; then
    echo "→ Backing up..."
    mkdir -p "$(dirname "$backup_stamp")"
    if backup_email.sh; then
      date +%s >"$backup_stamp"
    else
      echo "Warning: backup_email.sh failed"
    fi
  else
    echo "→ Skipping backup (last ran $(( (now - last_run) / 60 )) min ago, interval is 120 min)"
  fi
fi
