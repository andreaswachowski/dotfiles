<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
      <key>Label</key>
      <string>arpa.home.secrets_mount</string>
      <key>ProgramArguments</key>
      <array>
              <string>/bin/bash</string>
              <string>-lc</string>
              <string>"$HOME/.secrets/decrypt_secrets.sh" &amp;&amp; launchctl kickstart -p "gui/$(id -u)/arpa.home.pve_uploader"</string>
      </array>
      <key>RunAtLoad</key>
      <true/>
      <key>StandardOutPath</key>
      <string>/tmp/secrets_mount.log</string>
      <key>StandardErrorPath</key>
      <string>/tmp/secrets_mount.log</string>
</dict>
</plist>
